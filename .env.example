# Telegram Bot Credentials for Burmese Stories Broadcast
# 1. Obtain token from @BotFather
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# 2. Channel username (e.g. @stellarpub_official) or numeric ID (-100xxxxxxxxxx)
TELEGRAM_CHAT_ID="@stellarpub_official"

# 3. exe.io Developer API Token (https://exe.io/tools/developer-api)
EXE_IO_API_KEY="your_exe_io_api_token_here"
